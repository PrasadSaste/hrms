APP_NAME="Beyond Sure HRMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MySQL 8 (or MariaDB 10.6+) is the supported production database.
# Create the schema with utf8mb4 so names and currency symbols store correctly:
#   CREATE DATABASE hrms_bysure CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrms_bysure
DB_USERNAME=root
DB_PASSWORD=

# Set to sqlite only for a throwaway local trial:
#   DB_CONNECTION=sqlite   (then run: touch database/database.sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Employee credentials, leave decisions and salary slips are sent from here.
# Use "log" in development to write emails to storage/logs/laravel.log instead.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@bysure.in"
MAIL_FROM_NAME="BeyondSure Private Limited"
# Anywhere but production every message goes to this one inbox instead of to
# the employee it names, so a staging server seeded with real people cannot
# mail them. The real recipients travel on the message as X-Original-To.
# Ignored entirely when APP_ENV=production, so leaving it set is safe.
MAIL_REDIRECT_ALL_TO=api@shrigodatechlabs.com
MAIL_REDIRECT_ALL_NAME="HRMS test inbox"


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Setup
# ---------------------------------------------------------------------------
# Until the setup wizard has been completed, every page redirects to it and it
# is open to anybody who can reach the site. Finish it as soon as the site is
# up. A deployment that provisions from the command line instead should set
# this to true, and then the wizard can never be reached over the web at all.
INSTALL_LOCKED=false

# ---------------------------------------------------------------------------
# HRMS
# ---------------------------------------------------------------------------
# Seed the demo workforce outside local/staging (leave false in production).
SEED_DEMO_DATA=false

# Comma-separated origins allowed to call the API with cookie auth.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
