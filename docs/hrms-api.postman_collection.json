            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/leave?status=pending&year=2026&per_page=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "leave"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Optional: pending, approved, rejected, cancelled."
                },
                {
                  "key": "year",
                  "value": "2026",
                  "description": "Optional."
                },
                {
                  "key": "per_page",
                  "value": "20",
                  "description": "Defaults to 20."
                }
              ]
            },
            "description": "The caller's own requests, newest first. `can_cancel` on each row says whether the cancel endpoint will accept it."
          },
          "response": []
        },
        {
          "name": "Apply",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/leave",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "leave"
              ]
            },
            "description": "201 with the created request and its reference.\n\nRefused as a 422 for an overlap, an insufficient balance, too little notice, or a run past the type's consecutive-day limit.\n\nSent as multipart so an attachment can be included; drop the `attachment` row if there is none.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "leave_type_id",
                  "value": "1",
                  "type": "text",
                  "description": "Required."
                },
                {
                  "key": "start_date",
                  "value": "2026-09-20",
                  "type": "text",
                  "description": "Required."
                },
                {
                  "key": "end_date",
                  "value": "2026-09-21",
                  "type": "text",
                  "description": "Required, on or after start_date."
                },
                {
                  "key": "day_type",
                  "value": "full_day",
                  "type": "text",
                  "description": "full_day, first_half or second_half."
                },
                {
                  "key": "reason",
                  "value": "Family function out of town.",
                  "type": "text",
                  "description": "Required, 5 to 1000 characters."
                },
                {
                  "key": "contact_during_leave",
                  "value": "+91 98xxxxxx01",
                  "type": "text",
                  "description": "Optional, max 64 characters."
                },
                {
                  "key": "attachment",
                  "type": "file",
                  "src": [],
                  "description": "Optional. Max 5 MB, pdf/jpg/jpeg/png. Required for some types.",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
