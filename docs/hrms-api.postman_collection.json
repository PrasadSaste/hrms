{
  "info": {
    "name": "BySure HRMS API v1",
    "_postman_id": "b7e1f0a2-3c4d-4e5f-9a10-hrms0000v1",
    "description": "Every employee-facing feature of BySure HRMS, authenticated with Sanctum personal access tokens.\n\n**Getting started**\n\n1. Set the `base_url` variable to your host, without a trailing slash (e.g. `https://hrms.example.in`).\n2. Run **Authentication → Login**. Its test script stores the token in the collection variable `token`, and every other request sends it as a bearer token automatically.\n3. Tokens last 30 days. On a 401, run Login again.\n\n**Things worth knowing**\n\n- Attendance, your own leave and payslips are closed with a 403 until a new joiner's background verification clears.\n- Check-in and check-out require coordinates while *Require location to check in and out* is on. `GET /attendance/today` reports that as `location_required`.\n- A day can hold several punch pairs and several breaks.\n\nFull reference: docs/API.md in the repository.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Host only, no trailing slash and no /api/v1."
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Filled in by the Login request."
    },
    {
      "key": "token_expires_at",
      "value": "",
      "type": "string"
    },
    {
      "key": "email",
      "value": "arjun.sharma@beyondsure.example",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "leave_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "payslip_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "notification_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Issue, inspect and revoke personal access tokens.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "login"
              ]
            },
            "description": "Public. Rate limited to 10 requests a minute per IP, and 5 failed attempts per email and IP before a 429.\n\nThe test script captures `token` into the collection, so run this first.\n\nReturns `must_change_password` for a joiner still on the password from their welcome email.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{email}}",
                  "description": "Required.",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "description": "Required.",
                  "type": "text"
                },
                {
                  "key": "device_name",
                  "value": "Postman",
                  "description": "Optional, max 64 characters. Names the token so it can be revoked on its own.",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Capture the token so every other request in this collection is signed in.",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('token', body.token);",
                  "    pm.collectionVariables.set('token_expires_at', body.expires_at);",
                  "    if (body.must_change_password) {",
                  "        console.warn('This account must change its password before using the app.');",
                  "    }",
                  "}",
                  "pm.test('Signed in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "The signed-in user with their roles, permissions and employee record. Call it on launch to confirm the token still works and pick up a role change."
          },
          "response": []
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/change-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "change-password"
              ]
            },
            "description": "Clears `must_change_password`. Existing tokens keep working.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "current_password",
                  "value": "{{password}}",
                  "description": "Required, must match.",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "NewPassword123!",
                  "description": "Required, must meet the password policy.",
                  "type": "text"
                },
                {
                  "key": "password_confirmation",
                  "value": "NewPassword123!",
                  "description": "Must match `password`.",
                  "type": "text"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "logout"
              ]
            },
            "description": "Revokes the token that made this call. Other devices stay signed in."
          },
          "response": []
        },
        {
          "name": "Logout everywhere",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/logout-all",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "logout-all"
              ]
            },
            "description": "Revokes every token this user holds, on every device."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Attendance",
      "description": "A day is sessions and breaks. Punching in opens a session, punching out closes it, and either can happen several times a day. Every response returns the day's summary, rebuilt from those parts.\n\nClosed with a 403 until a new joiner's background verification clears.",
      "item": [
        {
          "name": "Today",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/attendance/today",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "today"
              ]
            },
            "description": "Today's punch state. Read `location_required` before drawing the punch button, so the location permission can be asked for at a sensible moment."
          },
          "response": []
        },
        {
          "name": "Check in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/attendance/check-in",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "check-in"
              ]
            },
            "description": "Opens a session. 201 on success.\n\nRefused if a session is already open or a break is running. Coordinates are required while the organisation requires a location — the rule is enforced on the server, so a client that skips them is refused, not silently recorded.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "latitude",
                  "value": "17.4401",
                  "description": "Required when `location_required`. Between -90 and 90.",
                  "type": "text"
                },
                {
                  "key": "longitude",
                  "value": "78.3489",
                  "description": "Required when `location_required`. Between -180 and 180.",
                  "type": "text"
                },
                {
                  "key": "accuracy",
                  "value": "18",
                  "description": "Optional, metres, as the device reported it.",
                  "type": "text"
                },
                {
                  "key": "location",
                  "value": "Hyderabad office",
                  "description": "Optional label, max 255 characters.",
                  "type": "text"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Break reasons",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/attendance/break-reasons",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "break-reasons"
              ]
            },
            "description": "The picker's contents. Fetch this rather than hard-coding the list — the catalogue can grow without a client release."
          },
          "response": []
        },
        {
          "name": "Start break",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/attendance/break/start",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "break",
                "start"
              ]
            },
            "description": "Suspends the day with a reason attached. 201 on success. Refused if no session is open or a break is already running.\n\nEvery reason is deducted from working time; recording which one is what makes an hour of client visits readable in the reports.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "reason",
                  "value": "lunch",
                  "description": "Required. One of the keys from Break reasons: lunch, outside_meeting, client_visit, client_call, personal_call, team_meeting, product_training, paperwork, other.",
                  "type": "text"
                },
                {
                  "key": "comment",
                  "value": "",
                  "description": "Optional, max 500 characters. Worth filling in for `other`.",
                  "type": "text"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "End break",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/attendance/break/end",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "break",
                "end"
              ]
            },
            "description": "Closes the running break and returns the day with `worked_minutes` recomputed. No body."
          },
          "response": []
        },
