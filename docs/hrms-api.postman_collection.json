                  "description": "Required when `location_required`.",
                  "type": "text"
                },
                {
                  "key": "longitude",
                  "value": "78.3489",
                  "description": "Required when `location_required`.",
                  "type": "text"
                },
                {
                  "key": "accuracy",
                  "value": "18",
                  "description": "Optional, metres.",
                  "type": "text"
                },
                {
                  "key": "location",
                  "value": "Hyderabad office",
                  "description": "Optional label.",
                  "type": "text"
                }
              ]
            }
          },
          "response": []
        },
        {
